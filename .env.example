# Copy this file to .env and fill in real values. Never commit .env.
#
# Running via `docker compose up` (see README §5)? Use DB_HOST=db and
# APP_URL=http://localhost:8080 — that's what docker-compose.yml expects.
# Running PHP natively against your own MySQL install instead? Use
# DB_HOST=127.0.0.1 (or your DB server's address) and whatever port you run on.

APP_NAME="Verapay"
APP_ENV=local
APP_URL=http://localhost:8080
APP_DEBUG=true

DB_HOST=db
DB_PORT=3306
DB_NAME=verapay
DB_USER=verapay_app
DB_PASS=secretpass

SESSION_LIFETIME_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
