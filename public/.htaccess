RewriteEngine On

# Apache/mod_php strips the Authorization header by default unless told
# otherwise - without this, bearer-token API auth (includes/auth.php)
# silently sees no header at all and falls through to session auth,
# which is confusing to debug. PHP's built-in dev server and PHP-FPM
# behind Nginx don't need this - they pass it through natively.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Serve real files/directories (assets, api/*.php) as-is.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else goes through the front controller, which reads the
# route from the URL path itself (see public/index.php) rather than a
# rewrite-generated query param.
RewriteRule ^ index.php [L]

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

Options -Indexes
